{
  "rules": {
    ".read": false,
    ".write": false,

    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "familyId": { ".validate": "newData.isString() && newData.val().length <= 40" },
        "displayName": { ".validate": "newData.isString() && newData.val().length <= 120" },
        "email": { ".validate": "newData.isString() && newData.val().length <= 200" }
      }
    },

    "inviteCodes": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && ((!data.exists() && newData.isString() && root.child('families').child(newData.val()).child('ownerUid').val() === auth.uid) || (data.exists() && !newData.exists() && root.child('families').child(data.val()).child('ownerUid').val() === auth.uid))",
        ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 40)"
      }
    },

    "families": {
      ".read": false,
      ".write": false,

      "$familyId": {
        ".read": "auth != null && root.child('families').child($familyId).child('members').child(auth.uid).exists()",
        ".write": "auth != null && (root.child('families').child($familyId).child('members').child(auth.uid).exists() || (!data.exists() && newData.child('ownerUid').val() === auth.uid))",

        "name": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 80" },
        "inviteCode": {
          ".validate": "newData.isString() && newData.val().length === 6 && (!data.exists() || newData.val() === data.val() || root.child('families').child($familyId).child('ownerUid').val() === auth.uid)"
        },
        "ownerUid": {
          ".validate": "(!data.exists() && newData.val() === auth.uid) || (data.exists() && newData.val() === data.val())"
        },
        "createdAt": { ".validate": "newData.isNumber()" },

        "members": {
          "$memberUid": {
            ".write": "auth != null && (auth.uid === $memberUid || root.child('families').child($familyId).child('ownerUid').val() === auth.uid)",
            ".validate": "newData.hasChildren(['role', 'joinedAt']) || newData.val() == null",
            "role": { ".validate": "newData.isString() && (newData.val() === 'owner' || newData.val() === 'member')" },
            "joinedAt": { ".validate": "newData.isNumber()" },
            "displayName": { ".validate": "newData.isString() && newData.val().length <= 120" }
          }
        },

        "push": {
          "$subId": {
            ".validate": "!newData.exists() || (newData.hasChildren(['endpoint', 'p256dh', 'auth', 'uid']) && newData.child('uid').val() === auth.uid)",
            "endpoint": { ".validate": "newData.isString() && newData.val().beginsWith('https://') && newData.val().length <= 800" },
            "p256dh": { ".validate": "newData.isString() && newData.val().length <= 200" },
            "auth": { ".validate": "newData.isString() && newData.val().length <= 100" },
            "uid": { ".validate": "newData.isString() && newData.val().length <= 128" },
            "ua": { ".validate": "newData.isString() && newData.val().length <= 120" },
            "createdAt": { ".validate": "newData.isNumber()" },
            "$other": { ".validate": false }
          }
        },

        "pushLog": {
          ".validate": "false"
        },

        "cars": {
          "$carId": {
            ".write": "auth != null && root.child('families').child($familyId).child('members').child(auth.uid).exists()",
            ".validate": "$carId.matches(/^[A-Za-z0-9_-]{1,40}$/) && (newData.hasChildren(['plate']) || newData.val() == null)",
            "plate": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 10" },
            "brand": { ".validate": "newData.isString() && newData.val().length <= 60" },
            "model": { ".validate": "newData.isString() && newData.val().length <= 60" },
            "year": { ".validate": "newData.isNumber() && newData.val() >= 1970 && newData.val() <= 2100" },
            "currentKm": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 999999" },
            "currentKmUpdatedAt": { ".validate": "newData.isNumber()" },
            "color": { ".validate": "newData.isString() && newData.val().length <= 20" },
            "updatedAt": { ".validate": "newData.isNumber()" },
            "updatedBy": { ".validate": "newData.isString()" },

            "services": {
              "$serviceId": {
                ".write": "auth != null && root.child('families').child($familyId).child('members').child(auth.uid).exists()",
                ".validate": "$serviceId.matches(/^[A-Za-z0-9_-]{1,40}$/) && (newData.hasChildren(['type']) || newData.val() == null)",
                "type": {
                  ".validate": "newData.isString() && (newData.val() === 'itp' || newData.val() === 'rca' || newData.val() === 'casco' || newData.val() === 'rovigneta' || newData.val() === 'taxa_pod' || newData.val() === 'ulei' || newData.val() === 'filtre' || newData.val() === 'distributie' || newData.val() === 'revizie' || newData.val() === 'roata_iarna' || newData.val() === 'roata_vara' || newData.val() === 'placute' || newData.val() === 'lichid_frana' || newData.val() === 'antigel' || newData.val() === 'baterie' || newData.val() === 'ac' || newData.val() === 'trusa' || newData.val() === 'extinctor' || newData.val() === 'impozit' || newData.val() === 'permis')"
                },
                "mode": { ".validate": "newData.isString() && (newData.val() === 'date' || newData.val() === 'mileage' || newData.val() === 'both')" },
                "lastDate": { ".validate": "newData.isString() && newData.val().length <= 12" },
                "nextDate": { ".validate": "newData.isString() && newData.val().length <= 12" },
                "intervalDays": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 3650" },
                "intervalMonths": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 240" },
                "lastKm": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 999999" },
                "intervalKm": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 500000" },
                "warnKmBefore": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 50000" },
                "warnDaysBefore": {
                  ".validate": "!newData.exists() || newData.hasChildren()",
                  "$i": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 365" }
                },
                "notes": { ".validate": "newData.isString() && newData.val().length <= 500" },
                "cost": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000" },
                "createdAt": { ".validate": "newData.isNumber()" },
                "updatedAt": { ".validate": "newData.isNumber()" },
                "reminderAt": { ".validate": "!newData.exists() || (newData.isString() && newData.val().length >= 11 && newData.val().length <= 16)" },
                "reminderNote": { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 200)" },
                "reminderFired": { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 16)" },
                "reminderPushed": { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 16)" }
              }
            },

            "history": {
              "$historyId": {
                ".write": "auth != null && root.child('families').child($familyId).child('members').child(auth.uid).exists()",
                ".validate": "$historyId.matches(/^[A-Za-z0-9_-]{1,40}$/) && (newData.hasChildren(['type', 'doneDate']) || newData.val() == null)",
                "type": { ".validate": "newData.isString()" },
                "doneDate": { ".validate": "newData.isString() && newData.val().length <= 12" },
                "doneKm": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 999999" },
                "cost": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000" },
                "notes": { ".validate": "newData.isString() && newData.val().length <= 500" },
                "doneBy": { ".validate": "newData.isString()" },
                "serviceId": { ".validate": "newData.isString()" },
                "createdAt": { ".validate": "newData.isNumber()" },
                "updatedAt": { ".validate": "newData.isNumber()" },
                "kind": { ".validate": "newData.isString() && newData.val().length <= 20" },
                "shop": { ".validate": "newData.isString() && newData.val().length <= 80" },
                "other": { ".validate": "newData.isString() && newData.val().length <= 200" },
                "ops": {
                  "$op": { ".validate": "newData.isBoolean() && $op.length <= 30" }
                }
              }
            },

            "tires": {
              "$tireId": {
                ".write": "auth != null && root.child('families').child($familyId).child('members').child(auth.uid).exists()",
                ".validate": "$tireId.matches(/^[A-Za-z0-9_-]{1,40}$/) && (newData.hasChildren(['season']) || newData.val() == null)",
                "season": { ".validate": "newData.isString() && (newData.val() === 'vara' || newData.val() === 'iarna' || newData.val() === 'all')" },
                "brand": { ".validate": "newData.isString() && newData.val().length <= 60" },
                "size": { ".validate": "newData.isString() && newData.val().length <= 30" },
                "dot": { ".validate": "newData.isString() && newData.val().length <= 4" },
                "treadMm": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 20" },
                "location": { ".validate": "newData.isString() && newData.val().length <= 80" },
                "mounted": { ".validate": "newData.isBoolean()" },
                "notes": { ".validate": "newData.isString() && newData.val().length <= 200" },
                "createdAt": { ".validate": "newData.isNumber()" },
                "updatedAt": { ".validate": "newData.isNumber()" },
                "$other": { ".validate": false }
              }
            }
          }
        }
      }
    }
  }
}